# Copy to .env and fill in. Never commit .env.

# Supabase project (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key (legacy JWT "eyJ..." format - required by supabase-py 2.7.4)
SUPABASE_KEY=your-anon-key
# Server-side only: bypasses Row Level Security. "sb_secret_..." or legacy JWT.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Flask session signing key - set a long random value
# (python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change-me
# Session: 3 months by default (ends earlier only on sign-out).
# SESSION_LIFETIME_DAYS=90
# Production over HTTPS: cookie sent over HTTPS only.
# SESSION_COOKIE_SECURE=1

# SuperAdmin created / promoted at startup (optional, both required to run)
SUPER_ADMIN_MAIL=admin@example.org
SUPER_ADMIN_PASSWORD=choose-a-strong-password

# Set to 0 to skip the SuperAdmin bootstrap at startup (e.g. in tests)
# SUPERADMIN_BOOTSTRAP=1

# Optional: verify Supabase access tokens locally (faster API calls)
SUPABASE_JWKS_URL=

# Outgoing e-mail: credentials sent to staff created by an administrator.
# SMTP_SECURITY: starttls (port 587), ssl (port 465) or none.
# MAIL_BACKEND=console writes the e-mails to the Flask log instead (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
MAIL_BACKEND=smtp

# NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/map_key/): fire hotspots.
MAP_KEY=
# Optional: FIRMS sources, refresh interval (minutes, >= 15), alert radius (km),
# and FIRE_SCHEDULER=0 to refresh only with `flask --app run fires-refresh` (cron).
# FIRE_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT
# FIRE_REFRESH_MINUTES=180
# FIRE_ALERT_RADIUS_KM=5
# FIRE_SCHEDULER=1

# KoboToolbox: personal tokens are encrypted with this key (Fernet). Optional:
# without it a key is derived from SUPABASE_SERVICE_ROLE_KEY.
# KOBO_ENCRYPTION_KEY=
# Background re-synchronisation of imported Kobo forms, in minutes (0: on demand only).
# KOBO_SYNC_MINUTES=0
